# Static/PHP hosting fallback ONLY. Never replace Hostinger managed Node.js routing.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  # This layout expects a separate API host, never local API-to-SPA fallback.
  RewriteRule ^api(?:/|$) - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^admin/(?:login|dashboard|leads|profile)/?$ /admin/index.html [L]
  RewriteRule ^(?:about|brands|gallery|awards|careers|contact|franchise-enquiry)/?$ /index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
