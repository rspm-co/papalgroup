# Copy to .env for local development. In Hostinger, set these in Environment Variables.
NODE_ENV=development
TZ=Asia/Kolkata
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rspapalgroup
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=5
# Use verified TLS for a remote database. Hostinger's local database may use DB_SSL=false.
DB_SSL=false
DB_SSL_CA=
# First deployment only: create versioned SQL tables before starting the server.
DB_AUTO_MIGRATE=false
# First deployment only: create the admin from ADMIN_* values below, then turn this off.
BOOTSTRAP_ADMIN=false
# Generate a unique value: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Production: replace example.com with the exact HTTPS domain used by visitors.
PUBLIC_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5000
# Number of trusted reverse proxies. Hostinger runs the app behind a proxy.
TRUST_PROXY=1
# Set true only for the combined website + admin + API deployment.
SERVE_STATIC=true
# Local / uploads are for development only; use Cloudinary for durable production uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by the explicit seed command. Never use VITE_ for these secrets.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Built into the public website for canonical links and sitemap. Defaults to PUBLIC_URL at build time.
VITE_SITE_URL=
# Optional override for split hosting. Combined hosting uses /api automatically.
VITE_API_BASE_URL=
